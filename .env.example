APP_NAME=MarkDev
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=markdev
DB_USERNAME=root
DB_PASSWORD=
# Seconds to wait for MySQL before giving up. Prevents a stalled database from
# being reported as a generic PHP execution-time fatal.
DB_CONNECT_TIMEOUT=10
# Directory holding mysqldump -- NOT the binary itself, and no trailing slash
# needed. backup:run shells out to mysqldump, so with this empty it calls a bare
# `mysqldump` and fails on any host that does not have one on PATH. Shared
# hosting usually does not: Hostinger keeps them somewhere like
# /opt/alt/mysql80/usr/bin. Empty is the old behaviour, which is correct for a
# machine where `which mysqldump` answers.
DB_DUMP_BINARY_PATH=

# Password given to accounts the office creates without typing one. Known and
# shared by design so staff can hand it over at the desk; change it before this
# reaches anything public.
DEFAULT_ACCOUNT_PASSWORD=password

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# Queued work goes to the jobs table, and the every-minute `queue:work` in
# routes/console.php is what empties it. Both halves are required: on a host with
# no worker this driver ACCEPTS every dispatch and runs none of it, so removing
# the scheduled drain makes dispatches disappear rather than fail. `sync` is not
# the alternative -- it would run the settings-save recaches inside the request,
# which is the 30-second timeout this project already had once (d9986d0).
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# --- Backups -----------------------------------------------------------------
# Where failure notices go. Spatie ships your@example.com, which belongs to
# somebody else, so this must be set before anyone relies on being told. Unset,
# it falls back to an address on .invalid that cannot be delivered: the send
# fails loudly in the log instead of quietly reaching a stranger.
BACKUP_NOTIFICATION_EMAIL=
# A second, off-server destination, by name from config/filesystems.php --
# `s3` is defined there and reads the AWS_* values above. Unset means local only,
# which means the backup lives on the disk it exists to protect. When it is set
# and not reachable the nightly job still writes the local copy and reports the
# failed disk; it is never taken down by an unconfigured destination.
BACKUP_OFFSITE_DISK=
# SET THIS BEFORE SETTING BACKUP_OFFSITE_DISK. The archive is the whole project
# directory, .env and APP_KEY included, so an off-server copy is a copy of every
# credential this application has. With this empty the zip is not encrypted.
BACKUP_ARCHIVE_PASSWORD=

VITE_APP_NAME="${APP_NAME}"
